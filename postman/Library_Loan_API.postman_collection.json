              "raw": "{{base_url}}/api/members?search=budi",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "members"
              ],
              "query": [
                {
                  "key": "search",
                  "value": "budi"
                }
              ]
            }
          }
        },
        {
          "name": "Get Member by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/members/{{member_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
