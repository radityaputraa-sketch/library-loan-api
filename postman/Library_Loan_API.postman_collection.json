            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"08111111111\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Delete Member",
          "request": {
            "method": "DELETE",
